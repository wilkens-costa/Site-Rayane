---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotaoAgendar from '../components/BotaoAgendar.astro';
import Icone from '../components/Icone.astro';
import Monograma from '../components/Monograma.astro';
---

<BaseLayout
  pagina="outra"
  title="Página não encontrada · Dra. Luzia Rayane"
  description="A página que você procura não existe. Volte para o início ou fale com a Dra. Luzia Rayane pelo WhatsApp."
  barraCta="404-barra"
>
  <meta slot="head" name="robots" content="noindex" />

  <section class="erro" aria-labelledby="erro-titulo">
    <div class="erro__relevo" aria-hidden="true"><Monograma /></div>
    <div class="wrap erro__in">
      <p class="erro__num" aria-hidden="true">404</p>
      <h1 id="erro-titulo">Esta página não <em>existe</em>.</h1>
      <p class="erro__texto">O link pode estar errado ou a página mudou de endereço. Volte ao início ou me chame no WhatsApp.</p>
      <div class="erro__acoes">
        <BotaoAgendar variante="claro" cta="404" principal />
        <a class="link-seta link-seta--luz" href="/"><span>Voltar ao início</span><Icone nome="seta" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Mesma família da abertura do Sobre: vinho do cartão, LR em relevo cortado pela margem */
  .erro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(100svh, 860px);
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 48px) 0 96px;
    background: var(--vinho-cartao);
    color: #fff;
    --foco: var(--champ-claro);
  }
  .erro__relevo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .erro__relevo :global(.mono) {
    position: absolute;
    width: max(280px, 46%);
    height: auto;
    right: -14%;
    bottom: -18%;
    color: var(--champ);
    opacity: 0.08;
  }
  .erro__num {
    font: italic 400 clamp(72px, 18vw, 140px) / 1 var(--serif);
    letter-spacing: -0.03em;
    color: var(--champ);
  }
  .erro h1 {
    margin-top: 16px;
    max-width: 11em;
    font-size: clamp(40px, 10.8vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    color: #fff;
    text-wrap: balance;
  }
  .erro h1 em {
    color: var(--champ-claro);
  }
  .erro__texto {
    margin-top: 20px;
    max-width: 30em;
    color: rgba(255, 255, 255, 0.86);
  }
  .erro__acoes {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }
  @media (min-width: 1024px) {
    .erro__texto {
      font-size: 18px;
    }
  }
</style>
