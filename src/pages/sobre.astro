---
import BaseLayout from '../layouts/BaseLayout.astro';
import Abertura from '../components/sobre/Abertura.astro';
import Filosofia from '../components/sobre/Filosofia.astro';
import Trajetoria from '../components/sobre/Trajetoria.astro';
import Galeria from '../components/sobre/Galeria.astro';
import Oferta from '../components/sobre/Oferta.astro';
import CtaSobre from '../components/sobre/CtaSobre.astro';
import { schemaSobre } from '../lib/schema';
import { site } from '../data/site';
---

<BaseLayout
  pagina="sobre"
  ogType="profile"
  title={`Sobre a Dra. Luzia Rayane · Cirurgiã-Dentista em Fortaleza | ${site.cro}`}
  description={`Conheça a Dra. Luzia Rayane, cirurgiã-dentista em Fortaleza com atendimento humanizado. Filosofia de trabalho, formação e onde atende. ${site.cro}.`}
  ogTitle="Sobre a Dra. Luzia Rayane · Cirurgiã-Dentista em Fortaleza"
  ogDescription="Conheça a profissional por trás do sorriso. Atendimento humanizado no Fátima, em Fortaleza."
  barraCta="sobre-barra"
  barraMensagem="sobre"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaSobre())} />
  </Fragment>

  <Abertura />
  <Filosofia />
  <Trajetoria />
  <Galeria />
  <Oferta />
  <CtaSobre />
</BaseLayout>
