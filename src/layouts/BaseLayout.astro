---
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Qual página está ativa no menu */
  page: 'home' | 'sobre' | 'outra';
  ogType?: 'website' | 'profile';
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, page, ogType = 'website', ogTitle = title, ogDescription = description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
    <script is:inline define:vars={{ ga4: site.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ga4);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#7A1B29" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dra. Luzia Rayane, cirurgiã-dentista em Fortaleza, de jaleco branco" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header page={page} />
    <BottomNav page={page} />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
    <slot name="after-footer" />

    <script>
      import '../scripts/reveal';
      import '../scripts/analytics';
    </script>
  </body>
</html>
