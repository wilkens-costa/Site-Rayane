---
import Icon from './Icon.astro';
import { waLink } from '../lib/whatsapp';

interface Props {
  page: 'home' | 'sobre' | 'outra';
}

const { page } = Astro.props;
const home = page === 'home';
const sobre = page === 'sobre';
---

<nav class="nav-bottom" aria-label="Navegação rápida">
  <a href={home ? '#hero' : '/#hero'} class:list={['nav-bottom__item', { 'is-active': home }]} aria-current={home ? 'page' : undefined}>
    <Icon name="solar:home-2-bold" />
    Início
  </a>
  <a href={home ? '#tratamentos' : '/#tratamentos'} class="nav-bottom__item">
    <Icon name="solar:health-bold" />
    Tratamentos
  </a>
  <a
    href={waLink('vimPeloSite')}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Agendar consulta pelo WhatsApp (abre em nova aba)"
    class="nav-bottom__item nav-bottom__item--center"
    data-cta="barra-inferior"
  >
    <Icon name="mdi:whatsapp" size={28} />
  </a>
  <a href="/sobre" class:list={['nav-bottom__item', { 'is-active': sobre }]} aria-current={sobre ? 'page' : undefined}>
    <Icon name="solar:user-bold" />
    Sobre
  </a>
  <a href={home ? '#contato' : '/#contato'} class="nav-bottom__item">
    <Icon name="solar:phone-bold" />
    Contato
  </a>
</nav>

{
  home && (
    <script>
      import '../scripts/nav-spy';
    </script>
  )
}
