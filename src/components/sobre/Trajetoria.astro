---
/**
 * Minha trajetória (vinho): só fatos confirmados, sem anos nem instituições.
 * A formatura sai da moldura (o capelo passa do fio de cima) e os fatos ficam numa ficha
 * na linguagem do cartão. Sem linha do tempo, porque não há datas.
 */
import { Picture } from 'astro:assets';
import Icone from '../Icone.astro';
import { site } from '../../data/site';
import { depoimentos } from '../../data/depoimentos';
import formatura from '../../assets/img/formatura-placa.webp';

const voz = depoimentos.jonasCuidado;
---

<section class="traj" id="trajetoria" aria-labelledby="traj-titulo">
  <div class="wrap traj__grid">
    <div class="traj__cab">
      <p class="traj__rotulo" data-revela>Minha trajetória</p>
      <h2 class="traj__titulo" id="traj-titulo" data-revela>Da beca ao jaleco.</h2>
    </div>
    <figure class="traj__foto" data-revela>
      <div class="traj__moldura">
        <Picture
          src={formatura}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[560, 900]}
          sizes="(min-width: 1024px) 480px, (min-width: 600px) 440px, 90vw"
          quality={82}
          alt="Dra. Luzia Rayane na formatura, de beca e capelo, sorrindo com o cachorrinho no colo"
        />
      </div>
      <figcaption>Na formatura, com companhia de quatro patas.</figcaption>
    </figure>
    <dl class="ficha" data-revela>
      <div>
        <dt>Formação</dt>
        <dd>Graduação em Odontologia</dd>
      </div>
      <div>
        <dt>Registro</dt>
        <dd>
          <span class="nw">{site.cro}</span><span class="ficha__nota">Inscrição ativa no Conselho Regional de Odontologia do Ceará.</span>
        </dd>
      </div>
      <div>
        <dt>Estudo</dt>
        <dd>Sigo estudando e me atualizando</dd>
      </div>
      <div>
        <dt>Hoje</dt>
        <dd>
          {site.clinica}
          <span class="ficha__nota"
            ><a class="link-seta link-seta--luz" data-link="mapa-sobre" href={site.mapaBusca} target="_blank" rel="noopener noreferrer"
              ><span>Como chegar</span><span class="sr-only"> (abre o Google Maps em nova janela)</span><Icone nome="seta" /></a
            ></span
          >
        </dd>
      </div>
    </dl>
    <figure class="voz" data-revela>
      <blockquote><p>“{voz.trecho}”</p></blockquote>
      <figcaption><span class="citacao__nome">{voz.nome}</span><span class="citacao__fonte">via Google</span></figcaption>
    </figure>
  </div>
</section>

<style is:global>
  /* =========================================================================
     10. MINHA TRAJETÓRIA — só fatos confirmados, sem anos nem instituições.
     A formatura sai da moldura (o capelo passa do fio de cima, como a Dra.
     sai da placa na home) e os fatos ficam numa ficha na linguagem do cartão:
     rótulo em itálico champagne + fio. Sem linha do tempo, porque não há datas.
     ========================================================================= */
  .traj { background: var(--vinho); color: #fff; padding: 80px 0 88px; --foco: var(--champ-claro); }
  .traj__grid { display: grid; grid-template-areas: "cab" "foto" "ficha" "voz"; }
  .traj__cab { grid-area: cab; }
  .traj__rotulo { font: italic 400 19px/1.3 var(--serif); color: var(--champ-claro); }
  .traj__titulo { margin-top: 10px; font-size: clamp(40px, 10.6vw, 64px); line-height: 1; letter-spacing: -.024em; color: #fff; text-wrap: balance; }
  /* a formatura: painel claro (o preto da beca não some no vinho), foto recortada que passa do topo */
  .traj__foto { grid-area: foto; margin: 92px 0 0; }
  .traj__moldura {
    position: relative; aspect-ratio: 4 / 4.3;
    /* corta os lados e a base (com o raio da placa), mas deixa o capelo passar do topo */
    clip-path: inset(-40% 0 0 0 round 0 0 var(--r-placa) var(--r-placa));
  }
  .traj__moldura::before { /* o painel */
    content: ''; position: absolute; inset: 0; border-radius: var(--r-placa);
    background: radial-gradient(120% 80% at 50% 18%, #FCF6F1 0%, #F2E4E1 52%, #E2CBC4 100%);
    box-shadow: inset 0 0 0 1px var(--fio-champ);
  }
  .traj__moldura::after { /* filete interno, por trás da Dra. (como na placa da home) */
    content: ''; position: absolute; inset: 8px; z-index: 1; pointer-events: none;
    border: 1px solid rgba(122, 27, 41, .22); border-radius: 8px;
  }
  .traj__moldura img { position: absolute; z-index: 2; left: 50%; bottom: 0; translate: -50% 0; height: 116%; width: auto; max-width: none; }
  .traj__foto figcaption { margin-top: 14px; font: italic 400 17px/1.4 var(--serif); color: var(--champ-claro); }
  /* a ficha */
  .ficha { grid-area: ficha; margin-top: 40px; border-top: 1px solid var(--fio-champ); }
  .ficha > div { display: grid; gap: 4px; padding: 18px 0 20px; border-bottom: 1px solid var(--fio-champ); }
  .ficha dt { font: italic 400 17px/1.3 var(--serif); color: var(--champ); }
  .ficha dd { font: 400 22px/1.3 var(--serif); color: #fff; text-wrap: balance; }
  .ficha__nota { display: block; margin-top: 6px; font: 400 16px/1.5 var(--sans); color: rgba(255, 255, 255, .78); text-wrap: pretty; }
  .ficha .link-seta { margin-top: 2px; font-size: 16px; }
  .traj .voz { grid-area: voz; margin-top: 36px; border-top: 0; padding-top: 0; }
  .traj .voz blockquote p { color: #fff; }
  .traj .voz .citacao__nome { color: #fff; }
  .traj .voz .citacao__fonte { color: var(--champ-claro); }
  @media (min-width: 480px) {
    .ficha > div { grid-template-columns: 7.5em minmax(0, 1fr); column-gap: 20px; align-items: baseline; }
  }
  @media (min-width: 600px) {
    .traj__foto { width: min(100%, 440px); }
  }
  @media (min-width: 768px) {
    .traj { padding: 128px 0 112px; }
    /* foto à esquerda; à direita, o título, a ficha e a voz */
    .traj__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 48px;
      grid-template-areas: "foto cab" "foto ficha" "foto voz"; grid-template-rows: auto auto 1fr;
    }
    .traj__foto { width: auto; margin: 0; align-self: center; }
    .traj__titulo { font-size: clamp(46px, 4.4vw + 4px, 64px); }
    .ficha { margin-top: 36px; }
    .ficha > div { grid-template-columns: 1fr; }
  }
  @media (min-width: 1024px) {
    .traj { padding: 152px 0 144px; }
    .traj__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 1fr) minmax(0, 6fr); column-gap: 0; grid-template-areas: "foto . cab" "foto . ficha" "foto . voz"; }
    .ficha { margin-top: 44px; }
    .ficha > div { grid-template-columns: 8em minmax(0, 1fr); column-gap: 24px; padding: 20px 0 22px; }
    .ficha dd { font-size: 24px; }
    .traj .voz { margin-top: 40px; }
  }
  @media (min-width: 1024px) {
    .traj .voz blockquote p { font-size: 22px; }
  }
</style>
