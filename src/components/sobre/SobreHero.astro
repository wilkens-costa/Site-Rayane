---
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import fundoConsultorio from '../../assets/img/consultorio-blur.webp';

const [fundoAvif, fundoWebp] = await Promise.all([
  getImage({ src: fundoConsultorio, width: 960, format: 'avif', quality: 45 }),
  getImage({ src: fundoConsultorio, width: 960, format: 'webp', quality: 55 }),
]);
const fundo = `image-set(url('${fundoAvif.src}') type('image/avif'), url('${fundoWebp.src}') type('image/webp'))`;
---

<section class="sobre-hero" style={`--sobre-hero-bg: ${fundo}`}>
    <div class="sobre-hero__inner">
        <p class="sobre-hero__breadcrumb">
            <a href="/">Início</a>
            <Icon name="solar:alt-arrow-right-linear" />
            Sobre a Doutora
        </p>
        <div class="sobre-hero__photo-placeholder">LR</div>
        <h1>Dra. Luzia <span>Rayane</span></h1>
        <p class="sobre-hero__sub">
            Cirurgiã-Dentista apaixonada por transformar sorrisos e resgatar a autoestima dos seus pacientes com cuidado humano e técnica avançada.
        </p>
    </div>
</section>

<style is:global>
/* ── SOBRE HERO ── */
.sobre-hero {
    background: linear-gradient(135deg, var(--color-bordo-dark) 0%, var(--color-bordo) 60%, var(--color-bordo-light) 100%);
    padding: 4rem var(--space-lg) 3rem;
    text-align: center;
    position: relative;
    overflow: hidden;
}
.sobre-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: var(--sobre-hero-bg);
    background-size: cover; background-position: center;
    opacity: 0.15; pointer-events: none;
}
.sobre-hero__inner { position: relative; z-index: 2; max-width: 700px; margin: 0 auto; }
.sobre-hero__breadcrumb {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.7);
    margin-bottom: 1.5rem;
}
.sobre-hero__breadcrumb a { color: rgba(255,255,255,0.7); text-decoration: none; transition: color 0.2s; }
.sobre-hero__breadcrumb a:hover { color: white; }
.sobre-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: var(--color-white); line-height: 1.1;
    margin-bottom: 1rem; letter-spacing: -0.02em;
}
.sobre-hero h1 span { font-style: italic; color: rgba(255,255,255,0.8); }
.sobre-hero__sub {
    color: rgba(255,255,255,0.85); font-size: 1.05rem; line-height: 1.6;
    max-width: 520px; margin: 0 auto 2rem;
}
.sobre-hero__photo {
    width: 120px; height: 120px; border-radius: 50%;
    border: 4px solid rgba(255,255,255,0.3);
    box-shadow: 0 16px 48px rgba(0,0,0,0.3);
    margin: 0 auto 1.5rem;
    object-fit: cover; object-position: top;
    background: rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
.sobre-hero__photo-placeholder {
    width: 120px; height: 120px; border-radius: 50%;
    border: 4px solid rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.5rem;
    font-family: var(--font-serif); font-size: 2.5rem;
    color: white; font-weight: 700;
    box-shadow: 0 16px 48px rgba(0,0,0,0.3);
}
</style>
