---
/**
 * CTA final do Sobre: a nota do Google numa linha, o título grande no rosé e a plaquinha em
 * escala de objeto (só o LR, o botão e o telefone). Abaixo, o convite para quem tem medo.
 * A formatura já aparece na trajetória, então aqui a placa não leva foto.
 */
import Placa from '../Placa.astro';
import BotaoAgendar from '../BotaoAgendar.astro';
import Estrelas from '../Estrelas.astro';
import Icone from '../Icone.astro';
import { site } from '../../data/site';
import { waLink } from '../../lib/whatsapp';
---

<section class="cta cta--sobre" id="contato" aria-labelledby="cta-titulo">
  <div class="wrap">
    <p class="cta__nota" data-revela>
      <strong><span class="sr-only">Nota </span>{site.notaGoogle}</strong>
      <Estrelas rotulo="de 5 estrelas no Google" />
      <a class="link-seta" data-link="avaliacoes-google" href={site.avaliacoesGoogle} target="_blank" rel="noopener noreferrer"
        ><span>Ver avaliações no Google</span><span class="sr-only"> (abre em nova janela)</span><Icone nome="seta" /></a
      >
    </p>
    <div class="cta__grid">
      <div>
        <h2 class="cta__titulo" id="cta-titulo" data-revela>Agora que você me conhece, vamos <em>conversar</em>?</h2>
        <p class="corpo cta__texto" data-revela>
          Me chame no WhatsApp, conte o que você precisa e combinamos juntos um horário que caiba na sua rotina.
        </p>
      </div>
      <div class="cta__acao">
        <Placa mini>
          <div class="placa__acoes">
            <BotaoAgendar variante="bordo" cta="sobre-final" mensagem="sobre" id="cta-final" principal />
            <a class="cta__tel" href={site.telefoneLink}><span>ou ligue</span><strong>{site.telefoneExibicao}</strong></a>
          </div>
        </Placa>
        <a class="convite-medo" data-cta="sobre-medo" data-revela href={waLink('medo')} target="_blank" rel="noopener noreferrer">
          <span class="convite-medo__q">Tem medo de dentista?</span>
          <span class="convite-medo__a"><span>Pode me contar já na primeira mensagem.</span><Icone nome="seta" /></span>
          <span class="sr-only"> (abre o WhatsApp em nova janela)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* =========================================================================
     16b. CTA FINAL — variante do Sobre. A placa em escala de objeto fica no
     Placa.astro (.placa--mini); aqui, a seção, a nota e o convite do medo.
     Seletores .cta.cta--sobre: vencem o .cta do Placa.astro sem depender da ordem do CSS.
     ========================================================================= */
  .cta.cta--sobre { padding: 64px 0 80px; }
  .cta__nota {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px;
    padding-bottom: 18px; border-bottom: 1px solid var(--fio); color: var(--tinta-2);
  }
  .cta__nota strong { font: 500 30px/1 var(--serif); color: var(--bordo); }
  .cta__nota .estrelas svg { fill: var(--bordo); }
  .cta__grid { margin-top: 40px; display: grid; gap: 32px; }
  .cta__titulo { font-size: clamp(36px, 9.6vw, 60px); line-height: 1.04; letter-spacing: -.022em; color: var(--tinta); text-wrap: balance; max-width: 11em; }
  .cta__titulo em { color: var(--bordo-claro); }
  .cta--sobre .cta__texto { margin-top: 16px; }
  .cta__acao { display: grid; gap: 18px; justify-items: start; }

  /* convite para quem tem medo (o mesmo da hero da home), em bordô sobre o rosé */
  .convite-medo {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; row-gap: 2px;
    min-height: 44px; align-content: center; text-decoration: none; color: var(--tinta);
  }
  .convite-medo__q { font: italic 400 20px/1.25 var(--serif); color: var(--bordo); }
  .convite-medo__a { display: inline-flex; align-items: center; gap: 8px; font: 500 16px/1.4 var(--sans); color: var(--tinta); }
  .convite-medo__a > span { background: linear-gradient(var(--bordo), var(--bordo)) 0 100% / 100% 1px no-repeat; padding-bottom: 2px; }
  .convite-medo__a svg { width: 18px; height: 18px; flex: none; color: var(--bordo); transition: transform .4s var(--ease); }
  .convite-medo:hover .convite-medo__a > span { background-image: linear-gradient(var(--bordo-claro), var(--bordo-claro)); }
  @media (prefers-reduced-motion: no-preference) {
    .convite-medo:hover svg { transform: translateX(4px); }
  }

  @media (min-width: 768px) {
    .cta.cta--sobre { padding: 96px 0 104px; }
    .cta__nota { padding-bottom: 22px; }
    .cta__grid { margin-top: 56px; }
  }
  @media (min-width: 1024px) {
    .cta.cta--sobre { padding: 120px 0 136px; }
    .cta__grid { margin-top: 72px; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); align-items: center; }
    .cta__titulo { font-size: clamp(52px, 4.6vw, 66px); }
    .cta--sobre .cta__texto { margin-top: 22px; max-width: 30em; }
  }
</style>
