---
import Icon from '../Icon.astro';
import { waLink } from '../../lib/whatsapp';
---

<section class="cta-meio">
    <div class="cta-meio__inner">
        <p class="cta-meio__eyebrow">Transforme seu sorriso</p>
        <h2 class="cta-meio__title">Agende sua Consulta</h2>
        <p class="cta-meio__text">Cuidado e atenção dedicados a você, do primeiro contato ao fim do tratamento.</p>
        <a href={waLink('agendar')} data-cta="cta-intermediario" target="_blank" rel="noopener noreferrer" class="btn-cta">
            <Icon name="mdi:whatsapp" />
            Agendar pelo WhatsApp
        </a>
    </div>
</section>

<style is:global>
.cta-meio {
    background: var(--color-bordo);
    padding: 2.5rem var(--space-lg);
    text-align: center;
}

.cta-meio__inner {
    max-width: 700px;
    margin: 0 auto;
}

.cta-meio__eyebrow {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
}

.cta-meio__title {
    font-family: var(--font-serif);
    color: var(--color-white);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin-bottom: 1rem;
}

.cta-meio__text {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.5rem;
}
</style>
