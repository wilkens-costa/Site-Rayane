---
import Icon from '../Icon.astro';
---

<section class="servicos section-padding">
    <div class="container">
        <div class="section-title">
            <h2>O que <span>Ofereço</span></h2>
            <p>Soluções completas para a saúde e beleza do seu sorriso.</p>
        </div>
        <div class="servicos__grid">
            <div class="servico-item">
                <Icon name="solar:users-group-rounded-bold-duotone" />
                <span>Atendimento adulto e infantil</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:magic-stick-3-bold-duotone" />
                <span>Clareamento dental</span>
            </div>
            <div class="servico-item">
                <Icon name="mdi:tooth-outline" />
                <span>Restaurações estéticas</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:star-fall-bold-duotone" />
                <span>Facetas de resina</span>
            </div>
            <div class="servico-item">
                <Icon name="mdi:tooth-outline" />
                <span>Cirurgias e extrações</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:medical-kit-bold-duotone" />
                <span>Urgência odontológica</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:heart-pulse-bold-duotone" />
                <span>Prevenção e profilaxia</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:sun-bold-duotone" />
                <span>Planejamento estético do sorriso</span>
            </div>
            <div class="servico-item">
                <Icon name="solar:clipboard-check-bold-duotone" />
                <span>Avaliação e plano de tratamento</span>
            </div>
        </div>
    </div>
</section>

<style is:global>
/* ── SERVICES LIST ── */
.servicos { background: var(--color-white); }
.servicos__grid {
    display: grid; grid-template-columns: 1fr;
    gap: 1rem; margin-top: 2rem;
}
@media (min-width: 640px) { .servicos__grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .servicos__grid { grid-template-columns: 1fr 1fr 1fr; } }
.servico-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 1rem 1.25rem; border-radius: 14px;
    background: var(--color-creme); border: 1px solid rgba(122,27,41,0.06);
}
.servico-item .icon { color: var(--color-bordo-light); font-size: 1.4rem; flex-shrink: 0; }
.servico-item span { font-size: 0.9rem; font-weight: 600; color: var(--color-bordo); }
</style>
