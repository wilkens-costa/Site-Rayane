---
/**
 * Galeria estática (sem carrossel, sem autoplay). O crachá abre a seção e sangra até a borda;
 * ao lado, o detalhe do consultório (com a voz de um paciente como legenda) e o bastidor
 * em tritom da paleta. Todas com o mesmo tratamento quente (scripts/imagens.mjs).
 */
import { Picture } from 'astro:assets';
import { site } from '../../data/site';
import { depoimentos } from '../../data/depoimentos';
import cracha from '../../assets/img/sobre-cracha.webp';
import sala from '../../assets/img/sobre-sala.webp';
import bastidor from '../../assets/img/sobre-bastidor.webp';

const voz = depoimentos.rafael;
---

<section class="galeria" id="galeria" aria-labelledby="galeria-titulo">
  <div class="wrap galeria__grid">
    <figure class="galeria__cracha" data-revela>
      <div class="galeria__quadro">
        <Picture
          src={cracha}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720]}
          sizes="(min-width: 768px) 45vw, 100vw"
          quality={78}
          alt="Crachá dourado com o monograma LR e o nome da Dra. Luzia Rayane, preso ao blazer"
        />
      </div>
      <figcaption>A plaquinha de todo dia.</figcaption>
    </figure>
    <div class="galeria__lado">
      <h2 class="galeria__titulo" id="galeria-titulo" data-revela>Detalhes de todo dia.</h2>
      <div class="galeria__par">
        <figure class="galeria__sala" data-revela>
          <div class="galeria__quadro">
            <Picture
              src={sala}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              quality={86}
              alt={`Detalhe do consultório na ${site.clinica}: prateleira iluminada com uma escultura de dente e um certificado emoldurado`}
            />
          </div>
          <figcaption class="galeria__voz">
            <q>{voz.trecho}</q><span><span class="citacao__nome">{voz.nome}</span><span class="citacao__fonte">via Google</span></span>
          </figcaption>
        </figure>
        <figure class="galeria__bastidor" data-revela data-revela-atraso="1">
          <div class="galeria__quadro">
            <Picture
              src={bastidor}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[520, 800, 1140]}
              sizes="(min-width: 1024px) 260px, (min-width: 768px) 22vw, 45vw"
              quality={80}
              alt="Retrato artístico da Dra. Luzia Rayane, em tons de vinho e dourado, com uma luz acesa ao lado do rosto"
            />
          </div>
          <figcaption>Nos bastidores.</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* =========================================================================
     11. GALERIA — estática (sem carrossel, sem autoplay). A foto abre a
     seção: o crachá sangra até a borda (no celular, de ponta a ponta; do
     tablet em diante, até a borda esquerda). O título é uma legenda curta.
     Todas com o mesmo tratamento quente; o bastidor em tritom da paleta.
     ========================================================================= */
  .galeria { background: var(--creme); padding: 0 0 88px; overflow-x: clip; }
  .galeria__grid { display: grid; }
  .galeria__cracha { margin-inline: calc((100% - 100vw) / 2); }
  .galeria__quadro { position: relative; overflow: hidden; background: #CFC6C2; aspect-ratio: 4 / 3.4; }
  .galeria__quadro img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .galeria__cracha img { object-position: 56% 50%; }
  .galeria figcaption { margin-top: 12px; font: italic 400 17px/1.35 var(--serif); color: var(--tinta-2); text-wrap: balance; }
  .galeria__cracha figcaption { padding-inline: max(var(--gutter), env(safe-area-inset-left)); }
  .galeria__titulo { margin-top: 44px; font-size: clamp(32px, 8.6vw, 44px); line-height: 1.06; letter-spacing: -.02em; color: var(--tinta); text-wrap: balance; max-width: 12em; }
  .galeria__par { margin-top: 28px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  /* fotos menores em moldura de placa (raio 14 + filete) */
  .galeria__par .galeria__quadro { border-radius: var(--r-placa); }
  .galeria__par .galeria__quadro::after {
    content: ''; position: absolute; inset: 8px; pointer-events: none; z-index: 1;
    border: 1px solid rgba(255, 255, 255, .5); border-radius: 8px;
  }
  .galeria__sala .galeria__quadro { aspect-ratio: 467 / 400; }
  .galeria__sala img { object-position: 50% 40%; }
  .galeria__bastidor { margin-top: 56px; }
  .galeria__bastidor .galeria__quadro { aspect-ratio: 4 / 5; background: var(--vinho-900); }
  .galeria__bastidor .galeria__quadro::after { border-color: rgba(232, 216, 160, .45); }
  .galeria__bastidor img { object-position: 55% 30%; }
  /* a voz de um paciente, como legenda do consultório */
  .galeria__voz { display: grid; gap: 8px; }
  .galeria__voz q { font: italic 400 19px/1.35 var(--serif); color: var(--tinta); quotes: '“' '”'; }
  .galeria__voz span { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  @media (min-width: 768px) {
    .galeria { padding: 128px 0 128px; }
    .galeria__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(32px, 5vw, 80px); align-items: stretch; }
    /* sangra até a borda esquerda da janela (o excesso da barra de rolagem é cortado pelo overflow-x: clip) */
    .galeria__cracha { margin: 0 0 0 calc((min(var(--max), 100vw - 2 * var(--gutter)) - 100vw) / 2); display: flex; flex-direction: column; }
    .galeria__cracha .galeria__quadro { flex: 1; aspect-ratio: auto; min-height: 420px; }
    .galeria__cracha figcaption { padding-inline: 0; margin-left: calc((100vw - min(var(--max), 100vw - 2 * var(--gutter))) / 2); }
    .galeria__titulo { margin-top: 0; font-size: clamp(34px, 3.6vw, 44px); }
    .galeria__par { margin-top: 36px; gap: 20px; }
    .galeria__bastidor { margin-top: 72px; }
  }
  @media (min-width: 1024px) {
    .galeria { padding: 152px 0 160px; }
    .galeria__par { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 28px; margin-top: 44px; }
    .galeria__sala { max-width: 360px; }
    .galeria__bastidor { margin-top: 128px; }
    .galeria__voz q { font-size: 21px; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .galeria__quadro img { transition: transform 1.2s var(--ease); }
    .galeria__quadro:hover img { transform: scale(1.025); }
  }
</style>
