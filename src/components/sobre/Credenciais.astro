---
import Icon from '../Icon.astro';
---

<section class="credenciais section-padding">
    <div class="container">
        <div class="section-title">
            <h2>Formação & <span>Credenciais</span></h2>
            <p>Uma trajetória sólida construída com dedicação, estudo e amor pela profissão.</p>
        </div>
        <div class="credenciais__list">
            <div class="credenciais__item">
                <div class="credenciais__icon">
                    <Icon name="solar:diploma-verified-bold-duotone" />
                </div>
                <div>
                    <h3>CRO CE 16735</h3>
                    <p>Inscrição ativa no Conselho Regional de Odontologia do Ceará.</p>
                </div>
            </div>
            <div class="credenciais__item">
                <div class="credenciais__icon">
                    <Icon name="solar:square-academic-cap-bold-duotone" />
                </div>
                <div>
                    <h3>Graduação em Odontologia</h3>
                    <p>Cirurgiã-dentista com atuação em clínica geral e na estética do sorriso.</p>
                </div>
            </div>
            <div class="credenciais__item">
                <div class="credenciais__icon">
                    <Icon name="solar:star-bold-duotone" />
                </div>
                <div>
                    <h3>Atualização em odontologia estética</h3>
                    <p>Cursos de atualização em clareamento, facetas de resina e planejamento estético do sorriso.</p>
                </div>
            </div>
            <div class="credenciais__item">
                <div class="credenciais__icon">
                    <Icon name="solar:map-point-bold-duotone" />
                </div>
                <div>
                    <h3>Atendimento na Marv Clinic — Fortaleza, CE</h3>
                    <p>R. Martinho Rodrigues, 129 - Fátima, Fortaleza - CE. Um espaço moderno, higienizado e preparado para o seu conforto.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
/* ── CREDENTIALS ── */
.credenciais { background: var(--color-creme); }
.credenciais__list {
    display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;
}
.credenciais__item {
    display: flex; align-items: flex-start; gap: 1rem;
    background: var(--color-white); border-radius: 16px; padding: 1.25rem 1.5rem;
    border: 1px solid rgba(122,27,41,0.06);
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
}
.credenciais__icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: rgba(122,27,41,0.07); flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-bordo); font-size: 1.4rem;
}
.credenciais__item h3 { font-size: 1rem; font-weight: 700; color: var(--color-bordo); margin-bottom: 0.2rem; }
.credenciais__item p { font-size: 0.9rem; color: var(--color-gray-text); line-height: 1.4; }
</style>
