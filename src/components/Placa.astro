---
/**
 * A plaquinha dourada do jaleco (CTA final): metal escovado, filete interno e só o LR gravado.
 * - Padrão (home): placa grande; a partir de 1024 px a foto do slot "foto" sai da placa.
 * - `mini` (Sobre): escala de objeto, LR | fio | botão e telefone.
 * O CSS também cobre a seção .cta e o link .cta__tel, comuns às duas páginas.
 */
import Monograma from './Monograma.astro';

interface Props {
  mini?: boolean;
}

const { mini = false } = Astro.props;
---

<div class:list={['placa', { 'placa--mini': mini }]} data-revela>
  <span class="placa__metal" aria-hidden="true"></span>
  <div class="placa__conteudo">
    <Monograma class="placa__mono" />
    <slot />
  </div>
  <slot name="foto" />
</div>

<style is:global>
  /* =========================================================================
     16. CTA FINAL — a plaquinha dourada do jaleco, em tamanho de placa.
     Só um LR pequeno gravado (o cartão completo fica no rodapé) e, no
     desktop, a Dra. de beca saindo da placa, ao lado do botão. Outra foto,
     outra pose: a hero não se repete.
     ========================================================================= */
  .cta { background: var(--rose); padding: 72px 0 80px; }
  .placa { position: relative; isolation: isolate; color: var(--vinho); padding: 44px 28px 42px; --foco: var(--vinho); }
  /* o metal: gradiente champagne + textura escovada + brilho a 118°.
     Fica numa camada própria para a foto poder vazar a borda sem cortar o brilho */
  .placa__metal {
    position: absolute; inset: 0; z-index: 0; overflow: hidden;
    border-radius: var(--r-placa);
    background:
      linear-gradient(118deg, rgba(255, 255, 255, .34) 0%, rgba(255, 255, 255, 0) 36%, rgba(255, 255, 255, 0) 70%, rgba(255, 255, 255, .12) 100%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, .055) 0 1px, rgba(90, 60, 20, .03) 1px 2px, transparent 2px 5px),
      linear-gradient(135deg, #EFE3B6 0%, #DCC48F 46%, #C6A86E 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .55) inset, 0 -1px 0 rgba(90, 60, 20, .18) inset, 0 28px 56px -32px rgba(68, 16, 30, .5);
  }
  .placa__metal::before { /* fio escuro interno, como na placa real */
    content: ''; position: absolute; inset: 10px;
    border: 1.5px solid rgba(42, 31, 33, .62); border-radius: 7px;
  }
  .placa__metal::after { /* brilho que atravessa a placa uma vez (só com movimento permitido) */
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, .38) 50%, transparent 65%);
    transform: translateX(-120%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .placa.is-visivel .placa__metal::after { transition: transform 1.8s var(--ease) .3s; transform: translateX(120%); }
  }
  .placa__conteudo { position: relative; z-index: 2; }
  .placa__mono { display: block; height: 40px; color: #2B1A1C; margin-bottom: 22px; }
  .placa h2 { font-size: clamp(34px, 9.4vw, 60px); line-height: 1.04; color: var(--vinho); text-wrap: balance; max-width: 10em; }
  .placa h2 em { color: var(--bordo); }
  .placa__texto { margin-top: 18px; max-width: 30em; color: #3A1B21; font-size: 16.5px; }
  .placa__acoes { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; }
  .placa__acoes .btn { flex: 1 1 100%; box-shadow: 0 12px 28px -14px rgba(68, 16, 30, .6); }
  .placa__acoes .btn__wa { box-shadow: 0 0 0 1px rgba(122, 27, 41, .1); }
  .cta__tel { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--vinho); text-decoration: none; font-size: 16px; }
  .cta__tel strong { font-weight: 600; background: linear-gradient(var(--bordo), var(--bordo)) 0 100% / 100% 1px no-repeat; padding-bottom: 2px; }
  .placa__foto { display: none; }
  @media (min-width: 768px) {
    .cta { padding: 104px 0; }
    .placa { padding: 60px 56px 58px; }
    .placa__metal::before { inset: 13px; }
    .placa__acoes .btn { flex: 0 0 auto; }
  }
  @media (min-width: 1024px) {
    .cta { padding: 176px 0 128px; }
    /* a foto tem coluna própria: o texto nunca passa por baixo dela, em nenhuma largura */
    .placa { display: grid; grid-template-columns: minmax(0, 1fr) clamp(440px, 42vw, 560px); align-items: center; padding: 0; }
    .placa__conteudo { grid-column: 1; grid-row: 1; padding: 80px 32px 84px clamp(56px, 7vw, 104px); }
    .placa__mono { height: 44px; margin-bottom: 30px; }
    .placa h2 { font-size: clamp(52px, 4.4vw, 66px); }
    /* a Dra. sai da placa: apoiada na base; a margem negativa deixa o capelo passar da borda de cima */
    .placa__foto {
      display: block; position: relative; z-index: 3; grid-column: 2; grid-row: 1; align-self: end;
      margin: -96px 40px 0 0; aspect-ratio: 900 / 1150; pointer-events: none;
    }
    .placa__foto img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; filter: drop-shadow(0 18px 24px rgba(68, 16, 30, .22)); }
  }

  /* =========================================================================
     16b. Placa em escala de objeto (CTA do Sobre): pequena, na proporção da
     plaquinha do jaleco (≈ 2,6:1), só com o LR, o botão e o telefone.
     ========================================================================= */
  .placa--mini { width: 100%; padding: 26px 22px 24px; }
  .placa--mini .placa__metal { box-shadow: 0 1px 0 rgba(255, 255, 255, .55) inset, 0 -1px 0 rgba(90, 60, 20, .18) inset, 0 18px 36px -26px rgba(68, 16, 30, .4); }
  .placa--mini .placa__conteudo { display: grid; gap: 16px; justify-items: start; }
  .placa--mini .placa__mono { height: 40px; margin: 0; }
  .placa--mini .placa__acoes { margin-top: 0; width: 100%; gap: 4px 20px; }
  @media (min-width: 480px) {
    /* LR | fio | botão e telefone: a composição da plaquinha, deitada */
    .placa--mini { padding: 26px 30px; }
    .placa--mini .placa__conteudo { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 26px; }
    .placa--mini .placa__mono { height: 58px; }
    .placa--mini .placa__acoes { flex-direction: column; align-items: flex-start; padding-left: 26px; border-left: 1px solid rgba(42, 31, 33, .32); }
    .placa--mini .placa__acoes .btn { flex: 0 0 auto; }
    .placa--mini .cta__tel { min-height: 36px; }
  }
  @media (min-width: 768px) {
    .placa--mini { width: min(100%, 520px); padding: 30px 36px; }
    .placa--mini .placa__metal::before { inset: 10px; }
  }
  @media (min-width: 1024px) {
    .placa--mini { display: block; padding: 30px 34px; }
    .placa--mini .placa__conteudo { padding: 0; }
    .placa--mini .placa__mono { height: 62px; }
  }
</style>
