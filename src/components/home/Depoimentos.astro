---
/** Depoimentos: a citação grande faz o papel de título; duas vozes menores ao lado. */
import Estrelas from '../Estrelas.astro';
import Icone from '../Icone.astro';
import { site } from '../../data/site';
import { depoimentos } from '../../data/depoimentos';

const grande = depoimentos.gizelle;
const menores = [depoimentos.gustavo, depoimentos.david];
---

<section class="depo" id="depoimentos" aria-labelledby="depo-titulo">
  <div class="wrap">
    <h2 class="sr-only" id="depo-titulo">Depoimentos de pacientes</h2>
    <div class="depo__topo">
      <p class="eyebrow" data-revela>Quem já sentou na cadeira</p>
      <p class="depo__nota" data-revela>
        <strong>{site.notaGoogle}</strong>
        <Estrelas rotulo="cinco estrelas" />
        <a class="link-seta" data-link="avaliacoes-google" href={site.avaliacoesGoogle} target="_blank" rel="noopener noreferrer"
          ><span>Ver avaliações no Google</span><Icone nome="seta" /></a
        >
      </p>
    </div>

    <div class="depo__corpo">
      <figure class="citacao citacao--grande" data-revela>
        <blockquote><p>“{grande.trecho}”</p></blockquote>
        <figcaption><span class="citacao__nome">{grande.nome}</span><span class="citacao__fonte">via Google</span></figcaption>
      </figure>

      <div class="depo__par">
        {
          menores.map((d, i) => (
            <figure class="citacao citacao--menor" data-revela data-revela-atraso={i > 0 ? String(i) : undefined}>
              <blockquote>
                <p>“{d.trecho}”</p>
              </blockquote>
              <figcaption>
                <span class="citacao__nome">{d.nome}</span>
                <span class="citacao__fonte">via Google</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* =========================================================================
     14. DEPOIMENTOS — a citação grande faz o papel de título
     ========================================================================= */
  .depo { background: var(--creme); padding: 96px 0 80px; }
  .depo__topo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 40px; }
  .depo__nota { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 16px; color: var(--tinta-2); }
  .depo__nota strong { font: 500 30px/1 var(--serif); color: var(--bordo); }
  .depo__nota .estrelas svg { fill: var(--ouro); }
  .citacao--grande { margin-top: 44px; }
  .citacao--grande blockquote p {
    font: italic 400 clamp(40px, 7vw + 14px, 84px)/1.1 var(--serif);
    color: var(--tinta); letter-spacing: -.02em;
    max-width: 11em; text-wrap: balance;
  }
  .citacao--grande figcaption { margin-top: 28px; }
  .depo__par { margin-top: 56px; display: grid; gap: 0; border-top: 1px solid var(--fio); }
  .citacao--menor { padding: 28px 0; border-bottom: 1px solid var(--fio); }
  .citacao--menor blockquote p { font: 400 19px/1.5 var(--serif); color: var(--tinta); }
  .citacao--menor figcaption { margin-top: 16px; }
  @media (min-width: 768px) {
    .depo { padding: 128px 0 112px; }
    .depo__par { grid-template-columns: 1fr 1fr; gap: 0 56px; border-top: 0; margin-top: 80px; }
    .citacao--menor { border-top: 1px solid var(--fio); border-bottom: 0; padding: 30px 0 0; }
  }
  @media (min-width: 1024px) {
    .depo { padding: 152px 0 144px; }
    /* citação-título à esquerda, as duas vozes empilhadas à direita */
    .depo__corpo { margin-top: 80px; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 1fr) minmax(0, 4fr); align-items: start; }
    .citacao--grande { margin-top: 0; grid-column: 1; }
    .citacao--grande blockquote p { font-size: clamp(60px, 5.4vw, 84px); }
    .depo__par { grid-column: 3; grid-template-columns: 1fr; margin: 0; gap: 0; }
    .citacao--menor { padding: 28px 0 32px; }
    .citacao--menor + .citacao--menor { margin-top: 8px; }
    .citacao--menor blockquote p { font-size: 20px; }
  }
</style>
