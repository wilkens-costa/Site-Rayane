---
import { Image } from 'astro:assets';
import { waLink } from '../../lib/whatsapp';
import dente from '../../assets/img/dente.png';
---

<a href={waLink('agendar')} data-cta="dente-flutuante"
    target="_blank" rel="noopener noreferrer" class="btn-whatsapp-float"
    aria-label="Falar com Dra. Luzia no WhatsApp">
    <span class="btn-whatsapp-float__bubble">Vamos agendar?</span>
    <Image src={dente} alt="" aria-hidden="true" width={80} densities={[1, 2]} loading="lazy" />
</a>

<style is:global>
/* ============================================================
   DECORATIVE ELEMENTS (Tooth PNG)
   ============================================================ */
/* Global Floating WhatsApp Tooth */
.btn-whatsapp-float {
    position: fixed;
    bottom: 90px;
    /* Restored back down near the tab bar */
    right: 15px;
    width: clamp(50px, 10vw, 65px);
    z-index: 9999;
    animation: float 4s ease-in-out infinite;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.3));
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    /* No mobile o único CTA flutuante é o botão central da barra inferior */
    display: none;
    align-items: center;
    justify-content: center;
}

.btn-whatsapp-float__bubble {
    position: absolute;
    bottom: 100%;
    /* Position ABOVE the tooth */
    right: -5px;
    /* Aligned near the right edge to prevent screen cut-off */
    left: auto;
    transform: none;
    margin-bottom: 8px;
    /* Space between bubble and tooth */
    background: #25D366;
    color: #ffffff;
    padding: 6px 10px;
    border-radius: 12px 12px 0 12px;
    /* Bottom right corner points to tooth */
    font-size: 0.65rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.3);
    pointer-events: none;
}

/* Little triangle pointing down to the tooth */
.btn-whatsapp-float__bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    /* Stick out the bottom */
    right: 20px;
    /* Aligned perfectly over the center of the tooth */
    left: auto;
    transform: none;
    border-width: 6px 6px 0 6px;
    /* Downward triangle */
    border-style: solid;
    border-color: #25D366 transparent transparent transparent;
}

.btn-whatsapp-float:hover {
    transform: scale(1.1) rotate(5deg);
}

.btn-whatsapp-float img {
    width: 100%;
    height: auto;
    pointer-events: none;
    /* Prevent interference with link click */
}

@keyframes float {

    0%,
    100% {
        transform: translateY(0) rotate(0);
    }

    50% {
        transform: translateY(-12px) rotate(5deg);
    }
}

@media (min-width: 1024px) {
    .btn-whatsapp-float {
        display: flex;
        bottom: 40px;
        right: 40px;
        width: 80px;
    }

    .btn-whatsapp-float__bubble {
        font-size: 0.8rem;
        padding: 8px 14px;
        border-radius: 16px;
    }

}
</style>
