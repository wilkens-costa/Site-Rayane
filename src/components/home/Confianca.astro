---
/** Faixa de confiança (parte da hero): 4 células com fios champagne, 2×2 no celular. */
import Estrelas from '../Estrelas.astro';
import Icone from '../Icone.astro';
import { site } from '../../data/site';
---

<div class="confianca">
  <ul class="wrap" role="list" aria-label="Por que confiar">
    <li>
      <a class="confianca__cel" data-link="avaliacoes-google" href={site.avaliacoesGoogle} target="_blank" rel="noopener noreferrer">
        <span class="confianca__k">{site.notaGoogle} <Estrelas rotulo="cinco estrelas" /></span>
        <span class="confianca__v"><span class="lk">Nota no Google</span><Icone nome="seta" /></span>
      </a>
    </li>
    <li>
      <div class="confianca__cel">
        <span class="confianca__k">{site.cro}</span>
        <span class="confianca__v">Cirurgiã-dentista</span>
      </div>
    </li>
    <li>
      <a class="confianca__cel" href="#onde-atendo">
        <span class="confianca__k">{site.clinica}</span>
        <span class="confianca__v"
          ><span class="so-tab lk">{site.endereco.rua}</span><span class="so-cel lk">Como chegar</span><Icone nome="seta" /></span
        >
      </a>
    </li>
    <li>
      <div class="confianca__cel">
        <span class="confianca__k">Toda a família</span>
        <span class="confianca__v">Adultos e crianças</span>
      </div>
    </li>
  </ul>
</div>

<style is:global>
  /* =========================================================================
     9. FAIXA DE CONFIANÇA — 4 células com fios champagne (parte da hero)
     ========================================================================= */
  .confianca { border-top: 1px solid var(--fio-champ); background: var(--vinho); }
  .confianca ul { display: grid; grid-template-columns: 1fr 1fr; }
  .confianca li { border-left: 1px solid var(--fio-champ); display: flex; }
  .confianca li:nth-child(odd) { border-left: 0; }
  .confianca li:nth-child(n+3) { border-top: 1px solid var(--fio-champ); }
  .confianca__cel {
    flex: 1; padding: 18px 0 18px 18px;
    display: grid; gap: 7px; align-content: start;
    text-decoration: none; color: inherit;
  }
  .confianca li:nth-child(odd) .confianca__cel { padding-left: 0; }
  .confianca__k { font: 500 clamp(16px, 4.7vw, 18px)/1.15 var(--serif); color: #fff; display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
  .confianca__v { font: 400 14px/1.35 var(--sans); color: var(--champ-claro); letter-spacing: .01em; }
  .confianca__v .lk { text-decoration: underline; text-decoration-color: var(--fio-champ); text-underline-offset: 3px; }
  a.confianca__cel:hover .lk { text-decoration-color: var(--champ-claro); }
  .confianca__v svg { width: 13px; height: 13px; vertical-align: -2px; margin-left: 2px; }
  a.confianca__cel:focus-visible { outline-offset: -4px; }
  @media (min-width: 768px) {
    .confianca__cel, .confianca li:nth-child(odd) .confianca__cel { padding: 24px 0 24px 28px; }
    .confianca li:nth-child(odd) .confianca__cel { padding-left: 0; }
    .confianca__k { font-size: 21px; }
  }
  @media (min-width: 980px) {
    .confianca ul { grid-template-columns: repeat(4, 1fr); }
    .confianca li:nth-child(n) { border-left: 1px solid var(--fio-champ); border-top: 0; }
    .confianca li:nth-child(1) { border-left: 0; }
    .confianca__cel, .confianca li:nth-child(odd) .confianca__cel { padding: 24px 0 26px 28px; }
    .confianca li:first-child .confianca__cel { padding-left: 0; }
    .confianca__k { font-size: 23px; }
    .confianca__v { font-size: 13.5px; }
  }
  @media (min-width: 980px) and (max-height: 820px) {
    .confianca__cel, .confianca li:nth-child(odd) .confianca__cel { padding-top: 18px; padding-bottom: 20px; }
    .confianca li:first-child .confianca__cel { padding-left: 0; }
  }
</style>
