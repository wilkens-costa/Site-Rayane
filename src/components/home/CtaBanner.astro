---
import Icon from '../Icon.astro';
import { waLink } from '../../lib/whatsapp';
---

<section class="cta-banner">
    <div class="cta-banner__inner">
        <p class="cta-banner__eyebrow">Não espere mais</p>
        <h2 class="cta-banner__title">Vamos cuidar do seu sorriso?</h2>
        <p class="cta-banner__text">Atendimento humanizado e sem pressa no Fátima, em Fortaleza. Agende sua avaliação.</p>
        <div class="cta-banner__actions">
            <a href={waLink('agendarMinha')} data-cta="cta-banner" target="_blank" rel="noopener noreferrer" class="cta-banner__btn cta-banner__btn--primary">
                <Icon name="mdi:whatsapp" />
                Agendar Consulta
            </a>
            <a href="/sobre" class="cta-banner__btn cta-banner__btn--ghost">Conhecer a Doutora</a>
        </div>
        <div class="cta-banner__badges">
            <span class="cta-banner__badge"><Icon name="solar:shield-check-bold" /> Atendimento humanizado</span>
            <span class="cta-banner__badge"><Icon name="solar:star-bold" class="cta-banner__star" /> 5,0 no Google</span>
            <span class="cta-banner__badge"><Icon name="solar:diploma-verified-bold" /> CRO CE 16735</span>
        </div>
    </div>
</section>

<style is:global>
.cta-banner {
    background: linear-gradient(135deg, var(--color-bordo-dark) 0%, var(--color-bordo) 100%);
    padding: 4rem var(--space-lg);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.cta-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(255, 255, 255, 0.06) 0%, transparent 60%);
    pointer-events: none;
}

.cta-banner__inner {
    position: relative;
    z-index: 2;
    max-width: 650px;
    margin: 0 auto;
}

.cta-banner__eyebrow {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
}

.cta-banner__title {
    font-family: var(--font-serif);
    color: var(--color-white);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
    line-height: 1.2;
}

.cta-banner__text {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    margin-bottom: 2rem;
    line-height: 1.5;
}

.cta-banner__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
}

.cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 1.1rem 2rem;
    border-radius: 999px;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s;
}

.cta-banner__btn--primary {
    background: var(--color-white);
    color: var(--color-bordo);
    padding: 1.1rem 2.2rem;
    font-weight: 800;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
}

.cta-banner__btn--primary .icon {
    font-size: 1.3rem;
    color: #25D366;
}

.cta-banner__btn--ghost {
    background: transparent;
    color: var(--color-white);
    font-weight: 600;
    border: 2px solid rgba(255, 255, 255, 0.35);
}

.cta-banner__badges {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
}

.cta-banner__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
}

.cta-banner__badge .icon {
    color: rgba(255, 255, 255, 0.5);
}

.cta-banner__badge .cta-banner__star {
    color: #F5A623;
}
</style>
