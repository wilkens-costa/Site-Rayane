---
/**
 * Hero aprovada pela Dra.: recorte à direita sobre o consultório desfocado + gradiente vinho;
 * no celular, o rosto no topo. H1 → lead → botão + microprova → atalhos (medo e urgência).
 * A faixa de confiança fecha a seção.
 */
import { Picture, getImage } from 'astro:assets';
import BotaoAgendar from '../BotaoAgendar.astro';
import Estrelas from '../Estrelas.astro';
import Icone from '../Icone.astro';
import Confianca from './Confianca.astro';
import { site } from '../../data/site';
import { waLink } from '../../lib/whatsapp';
import fotoDra from '../../assets/img/dra-luzia-hero.webp';
import consultorio from '../../assets/img/consultorio-blur.webp';

// Fundo desfocado do consultório (800 px no celular, 1600 px no desktop), AVIF com WebP de reserva
const fundo = async (width: number) => {
  const [avif, webp] = await Promise.all([
    getImage({ src: consultorio, width, format: 'avif', quality: 50 }),
    getImage({ src: consultorio, width, format: 'webp', quality: 60 }),
  ]);
  return `image-set(url('${avif.src}') type('image/avif'), url('${webp.src}') type('image/webp'))`;
};
const [fundoCel, fundoDesk] = await Promise.all([fundo(800), fundo(1600)]);
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__fundo" aria-hidden="true" style={`--hero-fundo-cel: ${fundoCel}; --hero-fundo-desk: ${fundoDesk}`}></div>
  <div class="hero__palco wrap">
    <figure class="hero__foto">
      <Picture
        src={fotoDra}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[960, 1200, 1600]}
        sizes="(min-width: 980px) 50vw, 116vw"
        alt="Dra. Luzia Rayane sorrindo, de jaleco branco bordado com seu nome"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero__texto">
      <h1 id="hero-titulo">Ir ao dentista pode ser <em>leve</em>.</h1>
      <p class="hero__lead">
        <span class="so-mob">No {site.endereco.bairro}, em {site.endereco.cidade}. Explico cada etapa e uso anestesia sempre que necessária.</span><span
          class="so-desk"
          >Cirurgiã-dentista no {site.endereco.bairro}, em {site.endereco.cidade}. Explico cada etapa antes de começar e uso anestesia sempre que
          necessária.</span
        >
      </p>
      <div class="hero__acoes">
        <BotaoAgendar variante="claro" cta="hero" id="cta-hero" principal />
        <p class="prova">
          <Estrelas />
          <span class="prova__nota nw"><strong>{site.notaGoogle}</strong> no Google</span>
          <span class="prova__sep" aria-hidden="true">·</span>
          <span class="prova__onde nw">{site.clinica}, {site.endereco.bairro}</span>
        </p>
      </div>
      <div class="atalhos">
        <a class="convite-medo" data-cta="hero-medo" href={waLink('medo')} target="_blank" rel="noopener noreferrer">
          <span class="convite-medo__q">Tem medo de dentista?</span>
          <span class="convite-medo__a"><span>Pode me contar já na primeira mensagem.</span><Icone nome="seta" /></span>
        </a>
        <a class="urgencia" data-cta="hero-urgencia" href={waLink('urgencia')} target="_blank" rel="noopener noreferrer">
          <span class="urgencia__q">Com dor ou dente quebrado?</span>
          <span class="urgencia__a"><span>Fale agora</span><Icone nome="seta" /></span>
        </a>
      </div>
    </div>
  </div>

  <Confianca />
</section>

<style is:global>
  /* =========================================================================
     8. HERO — composição aprovada pela Dra.: recorte à direita sobre o
     consultório desfocado + gradiente vinho; no celular, rosto no topo.
     Da C: microprova colada ao botão + convite para quem tem medo.
     ========================================================================= */
  .hero {
    position: relative; isolation: isolate;
    background: var(--vinho-cartao);
    color: #fff;
    overflow: hidden;
    --foco: var(--champ-claro);
  }
  .hero__fundo {
    position: absolute; inset: 0 0 auto; z-index: -2;
    height: calc(var(--header-h) + var(--foto-w) * .86);
    background: var(--hero-fundo-cel) 30% 50% / cover no-repeat;
  }
  .hero__fundo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(73, 16, 35, .6) 0%, rgba(73, 16, 35, .14) 22%, rgba(73, 16, 35, 0) 40%, rgba(73, 16, 35, .78) 76%, var(--vinho-cartao) 98%),
      linear-gradient(100deg, rgba(73, 16, 35, .72) 0%, rgba(73, 16, 35, .25) 55%, rgba(73, 16, 35, 0) 80%);
  }
  @media (min-width: 600px) {
    .hero__fundo::after {
      background:
        linear-gradient(180deg, rgba(73, 16, 35, .72) 0%, rgba(73, 16, 35, .28) 14%, rgba(73, 16, 35, 0) 40%, rgba(73, 16, 35, .78) 76%, var(--vinho-cartao) 98%),
        linear-gradient(100deg, rgba(73, 16, 35, .72) 0%, rgba(73, 16, 35, .25) 55%, rgba(73, 16, 35, 0) 80%);
    }
  }
  .hero__palco { position: relative; }
  .hero__foto {
    position: absolute; z-index: -1;
    top: calc(var(--header-h) - 4px);
    left: 50%;
    width: var(--foto-w);
    translate: -40% 0;
    /* some antes do título: o texto nunca fica sobre o jaleco branco */
    -webkit-mask-image: linear-gradient(180deg, #000 50%, rgba(0,0,0,.42) 60%, transparent 68%);
            mask-image: linear-gradient(180deg, #000 50%, rgba(0,0,0,.42) 60%, transparent 68%);
  }
  .hero__foto img { width: 100%; height: auto; }
  .hero__texto {
    padding-top: calc(var(--header-h) + var(--foto-w) * .64);
    padding-bottom: 30px;
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .hero h1 {
    font-size: clamp(40px, 11.8vw, 60px);
    line-height: 1.02;
    letter-spacing: -.022em;
    color: #fff;
    text-wrap: balance;
  }
  .hero h1 em { color: var(--champ-claro); }
  .hero__lead { margin-top: 14px; max-width: 30em; font-size: 16px; line-height: 1.5; color: rgba(255,255,255,.9); }
  .hero__acoes { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; width: 100%; }
  .hero__acoes .btn { flex: 1 1 100%; }

  /* Microprova colada ao botão (da C) */
  .prova {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 9px;
    font-size: 15px; line-height: 1.3; color: rgba(255, 255, 255, .86);
  }
  .prova .estrelas svg { width: 13px; height: 13px; }
  .prova strong { font: 500 18px/1 var(--serif); color: #fff; margin-right: 1px; }
  .prova__sep { color: var(--champ); }
  @media (max-width: 379.98px) {
    .prova { display: grid; grid-template-columns: auto 1fr; font-size: 14px; }
    .prova__sep { display: none; }
    .prova__onde { grid-column: 1 / -1; }
  }

  /* Atalhos da hero (da C): o convite para quem tem medo é um link próprio,
     só com tipografia (pergunta em itálico + frase sublinhada + seta), sem caixa.
     Logo abaixo, o atalho de urgência, mais discreto. Cada um com sua mensagem. */
  .atalhos { margin-top: 22px; display: grid; gap: 10px; justify-items: start; }
  .convite-medo, .urgencia {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; row-gap: 2px;
    color: #fff; text-decoration: none; min-height: 44px; align-content: center;
  }
  .convite-medo__q { font: italic 400 20px/1.25 var(--serif); color: var(--champ-claro); }
  .convite-medo__a, .urgencia__a {
    display: inline-flex; align-items: center; gap: 8px;
    font: 500 16px/1.4 var(--sans); color: #fff;
  }
  .convite-medo__a > span, .urgencia__a > span { background: linear-gradient(var(--champ), var(--champ)) 0 100% / 100% 1px no-repeat; padding-bottom: 2px; transition: background-image .3s; }
  .convite-medo__a svg, .urgencia__a svg { width: 18px; height: 18px; flex: none; color: var(--champ-claro); transition: transform .4s var(--ease); }
  .urgencia__q { font: 400 15px/1.4 var(--sans); color: rgba(255, 255, 255, .78); }
  .urgencia__a { font-size: 15px; }
  .convite-medo:hover .convite-medo__a > span, .urgencia:hover .urgencia__a > span { background-image: linear-gradient(var(--champ-claro), var(--champ-claro)); }
  @media (prefers-reduced-motion: no-preference) {
    .convite-medo:hover svg, .urgencia:hover svg { transform: translateX(4px); }
  }

  @media (min-width: 768px) {
    .hero h1 { font-size: 68px; }
    .hero__acoes .btn { flex: 0 0 auto; }
    .hero__lead { margin-top: 20px; font-size: 17px; line-height: 1.6; }
    .prova { display: grid; grid-template-columns: auto auto; justify-content: start; gap: 6px 9px; }
    .prova__sep { display: none; }
    .prova__onde { grid-column: 1 / -1; font-size: 14.5px; color: rgba(255, 255, 255, .78); }
    .convite-medo__q { font-size: 21px; }
  }

  /* Hero lado a lado: desktop e telas largas e baixas (celular deitado) */
  @media (min-width: 980px), (min-width: 700px) and (max-height: 560px) and (orientation: landscape) {
    .hero { min-height: clamp(660px, 100svh, 980px); display: grid; grid-template-rows: 1fr auto; }
    .hero__fundo { height: auto; inset: 0; background-image: var(--hero-fundo-desk); background-position: 50% 40%; }
    .hero__fundo::after {
      background:
        linear-gradient(98deg, rgba(54, 12, 24, .97) 0%, rgba(73, 16, 35, .93) 28%, rgba(73, 16, 35, .66) 45%, rgba(73, 16, 35, .2) 62%, rgba(73, 16, 35, 0) 78%),
        linear-gradient(0deg, rgba(68, 16, 30, .55) 0%, rgba(68, 16, 30, 0) 22%),
        linear-gradient(180deg, rgba(40, 8, 17, .66) 0%, rgba(40, 8, 17, .3) 9%, rgba(40, 8, 17, 0) 22%);
    }
    .hero__palco { display: flex; align-items: center; min-height: 0; }
    .hero__foto {
      top: auto; bottom: 0; left: auto;
      right: max(-160px, (min(var(--max), 100vw - 2 * var(--gutter)) - 100vw) / 2);
      width: auto; height: calc(100% - var(--header-h) - 18px);
      aspect-ratio: 1600 / 1589;
      translate: none;
      -webkit-mask-image: linear-gradient(270deg, transparent 0, #000 6%);
              mask-image: linear-gradient(270deg, transparent 0, #000 6%);
    }
    .hero__foto img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
    .hero__texto { padding: calc(var(--header-h) + 28px) 0 56px; max-width: min(640px, 50%); }
    /* a hero volta a ser o pico tipográfico da página */
    .hero h1 { font-size: clamp(56px, 6.4vw, 96px); line-height: .98; }
    .hero__lead { font-size: 18px; margin-top: 26px; max-width: 31em; }
    .hero__acoes { margin-top: 36px; flex-wrap: nowrap; }
    .hero__acoes .btn { flex: 0 0 auto; }
    /* no desktop a faixa de confiança já está na dobra: a microprova repetiria a nota */
    .prova { display: none; }
    .atalhos { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--fio-champ); gap: 4px; width: min(100%, 470px); }
  }
  @media (min-width: 700px) and (max-height: 560px) and (orientation: landscape) {
    .hero { min-height: 100svh; }
    .hero__texto { padding: calc(var(--header-h) + 12px) 0 24px; }
    .hero h1 { font-size: 44px; }
    .hero__lead { display: none; }
    .hero__acoes { margin-top: 18px; }
    .atalhos { margin-top: 12px; padding-top: 8px; }
    .urgencia { display: none; }
  }
  /* Notebooks com pouca altura (1280×720, 1366×768) */
  @media (min-width: 980px) and (max-height: 820px) {
    .hero { min-height: max(100svh, 600px); }
    .hero__texto { padding: calc(var(--header-h) + 8px) 0 28px; }
    .hero h1 { font-size: clamp(52px, 4.8vw, 68px); }
    .hero__lead { margin-top: 16px; font-size: 17px; }
    .hero__acoes { margin-top: 24px; }
    .atalhos { margin-top: 18px; padding-top: 12px; gap: 0; }
    .hero__foto { height: calc(100% - var(--header-h) - 10px); }
  }

  /* Movimento da hero: só transform (sem opacidade) para não atrasar o LCP */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes sobe { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes desliza { from { transform: translateY(16px); } to { transform: none; } }
    .hero__foto { animation: desliza 1.1s var(--ease) both; }
    .hero h1 { animation: desliza .9s var(--ease) both; }
    .hero__lead { animation: sobe .8s var(--ease) .1s both; }
    .hero__acoes { animation: sobe 1.1s var(--ease) .25s both; }
    .atalhos { animation: sobe 1.1s var(--ease) .4s both; }
  }
</style>
