---
/**
 * CTA final da home: a plaquinha dourada em tamanho de placa. A partir de 1024 px a coluna
 * da direita reproduz a gravação da plaquinha real (LR, nome cursivo, CRO), separada por um fio.
 */
import Placa from '../Placa.astro';
import BotaoAgendar from '../BotaoAgendar.astro';
import Monograma from '../Monograma.astro';
import NomeCursivo from '../NomeCursivo.astro';
import { site } from '../../data/site';
---

<section class="cta" id="contato" aria-labelledby="cta-titulo">
  <div class="wrap">
    <Placa>
      <h2 id="cta-titulo">Vamos marcar sua <em>avaliação</em>?</h2>
      <p class="placa__texto">Me chame no WhatsApp, conte o que você precisa e marcamos quando for bom para você.</p>
      <div class="placa__acoes">
        <BotaoAgendar variante="bordo" cta="final" id="cta-final" principal />
        <a class="cta__tel" href={site.telefoneLink}><span>ou ligue</span><strong>{site.telefoneExibicao}</strong></a>
      </div>
      <div class="placa__gravacao" slot="lateral" aria-hidden="true">
        <Monograma />
        <NomeCursivo />
        <span class="placa__gravacao-cro">Cirurgiã-dentista | {site.cro}</span>
      </div>
    </Placa>
  </div>
</section>
