---
/**
 * Tratamentos: título grande + lista editorial 01–07. Cada linha é um link para o WhatsApp
 * com a mensagem do tratamento (o link do h3 se estica sobre a linha inteira).
 * "Perguntar" com o glifo do WhatsApp em bordô: sempre visível no toque, no hover com mouse.
 */
import Icone from '../Icone.astro';
import { tratamentos, ctaTratamento } from '../../data/tratamentos';
import { waLink } from '../../lib/whatsapp';
---

<section class="trat" id="tratamentos" aria-labelledby="trat-titulo">
  <div class="wrap">
    <h2 class="trat__titulo" id="trat-titulo" data-revela>Da prevenção ao <em>clareamento</em>.</h2>
    <div class="trat__grid">
      <div class="trat__intro" data-revela>
        <p class="corpo">
          Tudo começa por uma avaliação. Indico só o que faz sentido para o seu caso, explico o porquê e você decide, no seu ritmo, o
          que fazer e quando.
        </p>
        <p class="trat__ajuda">
          Não sabe por onde começar?
          <a class="link-seta" href={waLink('duvidaTratamento')} target="_blank" rel="noopener noreferrer" data-cta="trat-duvida"
            ><span>Conte o que você sente</span><Icone nome="seta" /></a
          >
        </p>
      </div>

      <ol class="trat__lista" role="list" data-lista-wa>
        {
          tratamentos.map((t) => (
            <li class="trat__item" data-revela>
              <span class="trat__num" aria-hidden="true">
                {t.num}
              </span>
              <h3>
                <a href={waLink(t.mensagem)} target="_blank" rel="noopener noreferrer" data-cta={ctaTratamento(t)}>
                  <span class="trat__nome">{t.nome}</span><span class="sr-only">{t.urgente ? ': falar agora no WhatsApp' : ': perguntar no WhatsApp'}</span>
                </a>
              </h3>
              <p>{t.descricao}</p>
              <span class:list={['trat__ask', { 'trat__ask--urgente': t.urgente }]} aria-hidden="true">
                <Icone nome="wa" />
                {t.urgente ? 'Falar agora' : 'Perguntar'}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style is:global>
  /* =========================================================================
     12. TRATAMENTOS — título grande + lista editorial 01–07.
     Cada item abre o WhatsApp com mensagem própria; o glifo + "Perguntar"
     (da C) deixam isso óbvio, sempre visíveis no celular.
     ========================================================================= */
  .trat { background: var(--creme); padding: 88px 0 72px; overflow-x: clip; }
  .trat__titulo {
    font-size: clamp(42px, 4vw + 22px, 84px); /* sempre abaixo do H1 da hero */
    line-height: .98; letter-spacing: -.032em;
    color: var(--tinta); text-wrap: balance;
  }
  .trat__titulo em { color: var(--bordo-claro); }
  .trat__grid { margin-top: 32px; display: grid; gap: 36px; }
  .trat__ajuda { margin-top: 22px; display: grid; gap: 2px; color: var(--tinta); font: italic 400 19px/1.4 var(--serif); }
  .trat__lista { border-top: 1px solid var(--fio); }
  .trat__item {
    position: relative;
    display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; column-gap: 12px;
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--fio);
  }
  .trat__num { grid-row: 1 / span 2; font: italic 400 18px/1.4 var(--serif); color: var(--ouro); padding-top: 2px; transition: color .4s; }
  .trat__item h3 { grid-column: 2; align-self: center; font-size: 22px; line-height: 1.2; color: var(--tinta); transition: color .4s var(--ease); }
  .trat__item h3 a { text-decoration: none; color: inherit; }
  /* o link do h3 se estica sobre a linha inteira. Nenhum ancestral do <a> pode
     ter transform (viraria o bloco de contenção do ::after e encolheria a área
     clicável): o deslize do hover fica no span interno .trat__nome */
  .trat__item h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .trat__nome { display: inline-block; transition: transform .5s var(--ease); }
  .trat__item h3 a:focus-visible { outline: none; }
  .trat__item:has(a:focus-visible) { outline: 2px solid var(--foco); outline-offset: 2px; border-radius: 2px; }
  .trat__item p { grid-column: 2 / -1; margin-top: 8px; color: var(--tinta-2); font-size: 16px; line-height: 1.55; max-width: 32em; }
  /* "Perguntar" (da C): glifo do WhatsApp na cor da marca — o verde fica só no CTA principal */
  .trat__ask {
    grid-column: 3; grid-row: 1; align-self: center;
    display: inline-flex; align-items: center; gap: 7px;
    font: 500 14px/1 var(--sans);
    color: var(--bordo);
    transition: color .4s var(--ease), opacity .4s var(--ease);
  }
  .trat__ask svg { width: 20px; height: 20px; fill: var(--bordo); flex: none; transition: transform .5s var(--ease); }
  .trat__ask--urgente { font-weight: 600; }
  /* telas estreitas: glifo sobre o rótulo, para o nome do tratamento respirar */
  @media (max-width: 479.98px) {
    .trat__ask { flex-direction: column; gap: 6px; font-size: 13px; min-width: 64px; text-align: center; }
    .trat__ask svg { width: 22px; height: 22px; }
  }
  .trat__item::after {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 0;
    background: var(--bordo); transition: width .7s var(--ease);
  }
  @media (hover: hover) {
    .trat__item:hover::after { width: 100%; }
    .trat__item:hover .trat__num, .trat__item:hover h3 { color: var(--bordo); }
    /* com mouse, o "Perguntar" aparece no hover/foco (no toque fica sempre visível) */
    .trat__ask { opacity: 0; }
    .trat__item:hover .trat__ask, .trat__item:focus-within .trat__ask { opacity: 1; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .trat__item:hover .trat__nome { transform: translateX(4px); }
    .trat__item:hover .trat__ask svg, .trat__item:has(a:focus-visible) .trat__ask svg { transform: rotate(-10deg) scale(1.12); }
  }
  @media (min-width: 768px) {
    .trat { padding: 120px 0 96px; }
    .trat__grid { margin-top: 48px; }
    .trat__item { grid-template-columns: 56px minmax(0, 1fr) auto; column-gap: 24px; padding: 26px 0 28px; }
    .trat__num { font-size: 22px; }
    .trat__item h3 { font-size: 25px; }
  }
  /* Em todas as larguras a linha é empilhada (numeral | nome sobre a descrição | perguntar):
     em colunas, os nomes longos quebravam e as linhas ficavam com alturas irregulares */
  @media (min-width: 1024px) {
    .trat { padding: 160px 0 120px; }
    .trat__grid { --sangria: calc((100vw - min(var(--max), 100vw - 2 * var(--gutter))) / 2); margin-top: 72px; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(48px, 6vw, 96px); align-items: start; }
    .trat__intro { position: sticky; top: 128px; padding-top: 30px; }
    .trat__ajuda { margin-top: 32px; }
    /* A lista sangra até a borda direita da tela: os fios saem do grid */
    .trat__lista { margin-right: calc(-1 * var(--sangria)); }
    .trat__item { padding-right: var(--sangria); }
    .trat__item h3 { font-size: 28px; }
    .trat__item p { max-width: 36em; }
  }
</style>
