---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { waLink } from '../../lib/whatsapp';
import { site } from '../../data/site';
import dente from '../../assets/img/dente.png';

const { endereco } = site;
---

<section class="contact section-padding" id="contato">
    <!-- Abstract Watermark (Desktop Only) -->
    <Image src={dente} class="contact__watermark" alt="" aria-hidden="true" width={350} loading="lazy" />

    <div class="contact__container">
        <div class="section-title" data-reveal>
            <h2>Onde <span>Atendemos</span></h2>
            <p>Será um prazer receber você para uma avaliação minuciosa e planejar o futuro do seu sorriso.</p>
        </div>

        <div class="contact__grid">
            <!-- Left: Contact Info -->
            <div class="contact__info" data-reveal="left">
                <div class="contact__card">
                    <div class="contact__card-icon">
                        <Icon name="solar:map-point-bold-duotone" size={24} />
                    </div>
                    <div>
                        <h3>{site.clinica}</h3>
                        <p>{endereco.rua} - {endereco.bairro}<br />{endereco.cidade} - {endereco.uf}, {endereco.cep}</p>
                    </div>
                </div>

                <div class="contact__card">
                    <div class="contact__card-icon">
                        <Icon name="solar:phone-bold-duotone" size={24} />
                    </div>
                    <div>
                        <h3>Telefone / WhatsApp</h3>
                        <p>{site.telefoneExibicao}</p>
                    </div>
                </div>

                <a href={waLink('agendarClinica')} data-cta="contato"
                    target="_blank" rel="noopener noreferrer" class="btn btn--primary contact__btn">
                    Agendar via WhatsApp
                    <Icon name="solar:arrow-right-bold" size={18} />
                </a>
            </div>

            <!-- Right: Map -->
            <div class="contact__map" data-reveal="right">
                <iframe
                    src={site.mapaEmbed}
                    allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    title="Localização da Marv Clinic em Fortaleza">
                </iframe>
            </div>
        </div>
    </div>
</section>

<!-- Spacer -->
<div class="scroll-spacer"></div>

<style is:global>
.contact__btn {
    width: 100%;
    margin-top: auto;
}

.contact__watermark {
    display: none;
    position: absolute;
    top: -20px;
    right: -20px;
    width: 150px;
    opacity: 0.25;
    /* Noticeable on white bg */
    pointer-events: none;
    z-index: 1;
    /* Sits naturally behind text (text container is z-index:10) */
    transform: rotate(-10deg);
}

@media (min-width: 1024px) {
    .contact__watermark {
        display: block;
        top: 0;
        left: -2%;
        right: auto;
        width: 35vw;
        max-width: 500px;
        opacity: 0.1;
        transform: rotate(-15deg);
    }
}

/* ============================================================
   CONTACT SECTION
   ============================================================ */
.contact {
    background: var(--color-white);
    position: relative;
    z-index: 10;
}

.contact__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
}

.contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
}

@media (min-width: 900px) {
    .contact__grid {
        grid-template-columns: 1fr 1.2fr;
        gap: var(--space-3xl);
        align-items: stretch;
    }
}

.contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background: var(--color-creme);
    padding: var(--space-lg);
    border-radius: 24px;
    border: 1px solid rgba(122, 27, 41, 0.08);
}

@media (min-width: 768px) {
    .contact__info {
        padding: var(--space-2xl);
        gap: var(--space-lg);
    }
}

.contact__card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
}

.contact__card-icon {
    width: 50px;
    height: 50px;
    background: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-bordo);
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
}

.contact__card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-bordo);
    margin-bottom: 0.2rem;
    line-height: 1.2;
}

.contact__card p {
    font-size: 0.95rem;
    color: var(--color-gray-text);
    line-height: 1.5;
}

.contact__map {
    width: 100%;
    height: 350px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(122, 27, 41, 0.08);
    display: flex;
}

@media (min-width: 900px) {
    .contact__map {
        height: auto;
        min-height: 100%;
    }
}

.contact__map iframe {
    width: 100%;
    height: 100%;
    border: none;
    flex: 1;
    min-height: 350px;
}

/* Scroll Spacer */
.scroll-spacer {
    height: 10vh;
    background: var(--color-white);
    position: relative;
    z-index: 10;
}
</style>
