---
/** FAQ em <details>/<summary> nativos (acessível e funciona sem JS). Dados: src/data/faq.ts. */
import { faq } from '../../data/faq';
import { site } from '../../data/site';
import { waLink } from '../../lib/whatsapp';
---

<div class="faq" data-revela>
  <h3 class="faq__t">Perguntas que sempre chegam</h3>
  {
    faq.map((item) => (
      <details>
        <summary>{item.pergunta}</summary>
        <div class="faq__resp">
          <p>
            {item.resposta.map((t) =>
              typeof t === 'string' ? (
                t
              ) : 'whatsapp' in t ? (
                <a href={waLink(t.whatsapp)} target="_blank" rel="noopener noreferrer" data-cta={t.cta}>{t.texto}</a>
              ) : (
                <a href={site.telefoneLink} class="nw">{t.texto}</a>
              ),
            )}
          </p>
        </div>
      </details>
    ))
  }
</div>

<style is:global>
  /* FAQ (bloco 13 da home final) */
  .faq__t { font: italic 400 19px/1.3 var(--serif); color: var(--champ); margin-bottom: 6px; }
  .faq details { border-bottom: 1px solid rgba(184, 152, 96, .3); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    min-height: 60px; padding: 14px 0;
    font: 400 20px/1.3 var(--serif); color: #fff;
    transition: color .3s;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: ''; flex: none; width: 14px; height: 14px;
    background: linear-gradient(var(--champ), var(--champ)) center / 100% 1.5px no-repeat, linear-gradient(var(--champ), var(--champ)) center / 1.5px 100% no-repeat;
    transition: transform .35s var(--ease);
  }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq summary:hover { color: var(--champ-claro); }
  .faq summary:focus-visible { outline-offset: 2px; }
  .faq__resp { padding: 0 0 22px; color: rgba(255, 255, 255, .84); max-width: 36em; }
  .faq__resp a { color: var(--champ-claro); text-decoration: underline; text-decoration-color: var(--fio-champ); text-underline-offset: 3px; font-weight: 500; }
  .faq__resp a:hover { text-decoration-color: var(--champ-claro); }
  @media (prefers-reduced-motion: no-preference) {
    .faq details[open] .faq__resp { animation: faq-abre .45s var(--ease); }
    @keyframes faq-abre { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  }
</style>
