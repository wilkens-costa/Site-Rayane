---
import Icon from '../Icon.astro';
import { waLink } from '../../lib/whatsapp';
import { faq } from '../../data/faq';
---

<section class="faq section-padding" id="faq">
    <div class="faq__container">
        <div class="section-title">
            <h2>Perguntas <span>Frequentes</span></h2>
            <p>Tire suas dúvidas antes de agendar. Se não encontrar o que procura, fale direto com a Dra. Rayane!</p>
        </div>

        <div class="faq__list">
            {
                faq.map((item, i) => (
                    <div class="faq__item">
                        <h3 class="faq__heading">
                            <button class="faq__question" type="button" aria-expanded="false" aria-controls={`faq-resposta-${i}`}>
                                <span>{item.pergunta}</span>
                                <Icon name="solar:alt-arrow-down-linear" class="faq__icon" />
                            </button>
                        </h3>
                        <div class="faq__answer" id={`faq-resposta-${i}`}>
                            <p>{item.resposta}</p>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- CTA dentro do FAQ -->
        <div class="faq__cta">
            <p class="faq__cta-text">Ainda tem dúvidas? Estamos aqui para ajudar!</p>
            <p class="faq__cta-title">Fale agora com a Dra. Rayane</p>
            <a href={waLink('duvida')} data-cta="faq" target="_blank" rel="noopener noreferrer" class="cta-pill">
                <Icon name="mdi:whatsapp" />
                Tirar dúvida pelo WhatsApp
            </a>
        </div>
    </div>
</section>

<style is:global>
.faq {
    background: var(--color-creme);
}

.faq__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
}

.faq .section-title p {
    font-size: 0.95rem;
    line-height: 1.5;
}

.faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.faq__item {
    background: var(--color-white);
    border-radius: 16px;
    border: 1px solid rgba(122, 27, 41, 0.07);
    overflow: hidden;
}

.faq__heading {
    font: inherit;
}

.faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-bordo);
}

.faq__icon {
    font-size: 1.2rem;
    transition: transform 0.3s;
}

.faq__question[aria-expanded='true'] .faq__icon {
    transform: rotate(180deg);
}

.faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
}

.faq__answer p {
    padding: 0 1.5rem 1.25rem;
    color: var(--color-gray-text);
    font-size: 0.95rem;
    line-height: 1.6;
}

.faq__cta {
    text-align: center;
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--color-white);
    border-radius: 20px;
    border: 1px solid rgba(122, 27, 41, 0.07);
}

.faq__cta-text {
    color: var(--color-gray-text);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
}

.faq__cta-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-bordo);
    font-weight: 700;
    margin-bottom: 1.25rem;
}

.faq__cta .cta-pill {
    font-size: 0.95rem;
}
</style>

<script>
  // Acordeão: abre uma resposta por vez
  const buttons = document.querySelectorAll<HTMLButtonElement>('.faq__question');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const abrir = button.getAttribute('aria-expanded') !== 'true';

      buttons.forEach((outro) => {
        outro.setAttribute('aria-expanded', 'false');
        const resposta = document.getElementById(outro.getAttribute('aria-controls') ?? '');
        if (resposta) resposta.style.maxHeight = '0px';
      });

      if (abrir) {
        button.setAttribute('aria-expanded', 'true');
        const resposta = document.getElementById(button.getAttribute('aria-controls') ?? '');
        if (resposta) resposta.style.maxHeight = `${resposta.scrollHeight}px`;
      }
    });
  });
</script>
